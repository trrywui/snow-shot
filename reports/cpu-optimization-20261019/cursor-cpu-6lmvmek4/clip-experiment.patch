+bool canDrawOpaqueExposureRectangles(const QPainter& painter, const QRectF& target,
+                                     const QImage& image, const QRectF& source,
+                                     const QRegion& exposedRegion) {
+    // Bound the extra painter calls when damage is unusually fragmented. Qt's direct image
+    // paths cover 1x images and 2x images on a 2x device; other mappings keep the general path.
+    constexpr int kMaximumExposureRectangles = 128;
+    if (exposedRegion.rectCount() <= 1 || exposedRegion.rectCount() > kMaximumExposureRectangles ||
+        image.format() != QImage::Format_RGB32 || painter.opacity() != 1.0 ||
+        painter.testRenderHint(QPainter::SmoothPixmapTransform) ||
+        (painter.compositionMode() != QPainter::CompositionMode_SourceOver &&
+         painter.compositionMode() != QPainter::CompositionMode_Source) ||
+        !QRectF(image.rect()).contains(source)) {
+        return false;
+    }
+
+    const QTransform transform = painter.deviceTransform();
+    if (transform.type() > QTransform::TxScale ||
+        (transform.m11() != 1.0 && transform.m11() != 2.0) || transform.m22() != transform.m11()) {
+        return false;
+    }
+    const QRectF deviceTarget = transform.mapRect(target);
+    const auto pixelAligned = [](const QRectF& rect) {
+        return finiteRect(rect) && rect.left() == std::floor(rect.left()) &&
+               rect.top() == std::floor(rect.top()) && rect.width() == std::floor(rect.width()) &&
+               rect.height() == std::floor(rect.height());
+    };
+    return deviceTarget.size() == source.size() && pixelAligned(deviceTarget) &&
+           pixelAligned(source);
+}
