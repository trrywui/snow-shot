+void disjointOpaqueImageExposurePreservesPixelsAndPainterState() {
+    QImage source(QSize(96, 80), QImage::Format_RGB32);
+    for (int y = 0; y < source.height(); ++y) {
+        for (int x = 0; x < source.width(); ++x) {
+            source.setPixel(
+                x, y,
+                qRgb((x * 13 + y * 7) % 256, (x * 3 + y * 17) % 256, (x * 29 + y * 11) % 256));
+        }
+    }
+    const QRectF sourceRect(3, 5, 80, 60);
+    const QRegion exposed = QRegion(QRect(9, 11, 21, 13)) + QRect(40, 16, 27, 29) +
+                            QRect(15, 47, 62, 11) + QRect(110, 80, 10, 10);
+    for (const qreal dpr : {1.0, 2.0, 1.5}) {
+        const QRectF targetRect(7, 9, sourceRect.width() / dpr, sourceRect.height() / dpr);
+        for (int clipKind = 0; clipKind < 3; ++clipKind) {
+            for (const auto mode :
+                 {QPainter::CompositionMode_SourceOver, QPainter::CompositionMode_Source}) {
+                const auto render = [&](bool useHelper) {
+                    QImage output(QSize(qRound(128 * dpr), qRound(96 * dpr)),
+                                  QImage::Format_ARGB32_Premultiplied);
+                    output.setDevicePixelRatio(dpr);
+                    output.fill(QColor(12, 14, 16, 93));
+                    QPainter painter(&output);
+                    painter.translate(1, 2);
+                    painter.setCompositionMode(mode);
+                    painter.setRenderHint(QPainter::Antialiasing, true);
+                    if (clipKind == 1) {
+                        painter.setClipRegion(QRegion(QRect(12, 13, 48, 40)) -
+                                              QRect(23, 18, 19, 17));
+                    } else if (clipKind == 2) {
+                        QPainterPath clip;
+                        clip.addEllipse(QRectF(11.5, 12.5, 57, 43));
+                        painter.setClipPath(clip);
+                    }
+                    const bool hadClipping = painter.hasClipping();
+                    const QPainterPath originalClip = painter.clipPath();
+                    const QTransform originalTransform = painter.transform();
+                    const auto originalHints = painter.renderHints();
+                    if (useHelper) {
+                        paintExposedScreenshotImage(painter, targetRect, source, sourceRect,
+                                                    exposed);
+                    } else {
+                        painter.save();
+                        painter.setClipRegion(exposed, Qt::IntersectClip);
+                        painter.drawImage(targetRect, source, sourceRect);
+                        painter.restore();
+                    }
+                    require(painter.hasClipping() == hadClipping &&
+                                painter.clipPath() == originalClip &&
+                                painter.transform() == originalTransform &&
+                                painter.renderHints() == originalHints &&
+                                painter.compositionMode() == mode && painter.opacity() == 1.0,
+                            "exposed image rendering must restore the caller's painter state");
+                    painter.end();
+                    return output;
+                };
+                require(render(true) == render(false),
+                        "disjoint opaque exposure must preserve crop pixels, damage holes and "
+                        "caller clips at integer and fractional device pixel ratios");
+            }
+        }
+    }
+}
