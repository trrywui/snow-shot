+void externalBackgroundFollowsOverlayLifetime() {
+#ifdef Q_OS_MACOS
+    if (QGuiApplication::platformName() != QStringLiteral("cocoa"))
+        return;
+    const QByteArray previous = qgetenv("SNOW_SHOT_STATIC_BACKDROP");
+    qputenv("SNOW_SHOT_STATIC_BACKDROP", "1");
+    NoopOverlayEventSink sink;
+    SnowCanvasRuntime runtime;
+    ScreenshotOverlayWindow overlay(sink, new ScreenshotOverlayCanvasWidget(runtime));
+    if (previous.isNull())
+        qunsetenv("SNOW_SHOT_STATIC_BACKDROP");
+    else
+        qputenv("SNOW_SHOT_STATIC_BACKDROP", previous);
+    overlay.setCaptureGeometry(QRect(40, 80, 96, 72));
+    overlay.canvas()->setViewportCamera(0, 0, 1);
+    QImage image(96, 72, QImage::Format_RGB32);
+    image.fill(QColor(12, 34, 56));
+    overlay.setScreenshotImage(image, QRectF(-48, -36, 96, 72));
+    overlay.setCanvasClearBackgroundEnabled(true);
+    overlay.show();
+    QApplication::processEvents();
+    overlay.repaint();
+    auto* renderer = overlay.screenshotRendererForTesting();
+    const auto nativeId = overlay.winId();
+    require(renderer->externalBackgroundPresented() &&
+                snow_shot::platform::screenshotBackdropIsPassiveAndVisible(&overlay),
+            "native static backdrop must be visible, passive, and owned by the overlay");
+    require(!overlay.canvas()->clearBackgroundEnabled(),
+            "split canvas must not overwrite the native backdrop with its clear color");
+    overlay.setScrollingCaptureMode(true);
+    require(!snow_shot::platform::screenshotBackdropIsPassiveAndVisible(&overlay) &&
+                !renderer->externalBackgroundPresented(),
+            "scrolling must remove the native backdrop immediately");
+    overlay.setScrollingCaptureMode(false);
+    QApplication::processEvents();
+    overlay.repaint();
+    require(snow_shot::platform::screenshotBackdropIsPassiveAndVisible(&overlay),
+            "leaving scrolling must allow the backdrop to return");
+    overlay.hide();
+    require(!snow_shot::platform::screenshotBackdropIsPassiveAndVisible(&overlay) &&
+                overlay.canvas()->clearBackgroundEnabled(),
+            "hide must release native pixels and restore the requested canvas clear policy");
+    overlay.show();
+    QApplication::processEvents();
+    overlay.repaint();
+    require(overlay.winId() == nativeId && renderer->externalBackgroundPresented(),
+            "reusing the overlay must retain native identity and restore the backdrop");
+    overlay.releaseNativeSurface();
+    require(!renderer->externalBackgroundPresented() && overlay.internalWinId() == 0,
+            "surface release must retire the backdrop before destroying its native owner");
+#endif
+}
