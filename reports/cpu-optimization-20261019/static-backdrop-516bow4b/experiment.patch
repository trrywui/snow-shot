+    if (!pixels)
+        return false;
+    // Match Qt Cocoa's raster surface interpretation without converting/copying pixels.
+    NSColorSpace* nativeColorSpace = owner.colorSpace;
+    const QColorSpace requested = widget->windowHandle()->format().colorSpace();
+    if (requested.isValid()) {
+        NSColorSpace* explicitSpace = [[[NSColorSpace alloc]
+            initWithICCProfileData:requested.iccProfile().toNSData()] autorelease];
+        if (explicitSpace)
+            nativeColorSpace = explicitSpace;
+    }
+    CGImageRef tagged = CGImageCreateCopyWithColorSpace(pixels, nativeColorSpace.CGColorSpace);
+    CGImageRelease(pixels);
+    if (!tagged)
+        return false;
+    pixels = tagged;
+    clearScreenshotBackdrop(widget);
+    auto* state = [SnowScreenshotBackdrop new];
+    NSRect local =
+        NSMakeRect(canvasRect.x(), canvasRect.y(), canvasRect.width(), canvasRect.height());
+    if (!view.flipped)
