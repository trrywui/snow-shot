+bool presentScreenshotBackdrop(QWidget* widget, const QImage& image, const QRect& canvasRect) {
+    if (!widget || !widget->internalWinId() || image.isNull() || canvasRect.isEmpty() ||
+        QGuiApplication::platformName() != QStringLiteral("cocoa"))
