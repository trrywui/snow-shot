+void externalBackgroundKeepsSnapshotsAndOriginalPixels() {
+    SnowCanvasRuntime runtime;
+    ScreenshotOverlayCanvasWidget canvas(runtime);
+    canvas.resize(96, 72);
+    canvas.setAttribute(Qt::WA_TranslucentBackground);
+    canvas.setClearBackgroundEnabled(false);
+    canvas.show();
+    QApplication::processEvents();
+    require(canvas.setViewportCamera(0, 0, 1), "initialize external backdrop camera");
+    ScreenshotCanvasRenderer renderer(canvas);
+    canvas.setCustomRenderer(&renderer);
+    const QRectF sourceRect(-48, -36, 96, 72);
+    QImage source(96, 72, QImage::Format_RGB32);
+    for (int y = 0; y < source.height(); ++y)
+        for (int x = 0; x < source.width(); ++x)
+            source.setPixelColor(x, y, QColor(x * 2, y * 3, (x + y) % 256));
+    renderer.setImage(source, sourceRect);
+    renderer.setMaskVisible(true);
+    renderer.setSelection(QRectF(-24, -18, 48, 36), false, 4);
+    const QImage reference = renderCanvas(canvas, canvas.devicePixelRatioF());
+    const auto originalRevision = renderer.originalBackgroundRevision();
+    require(renderer.canPresentExternalBackground(),
+            "opaque viewport should allow split rendering");
+    const QImage backdrop = renderer.externalBackgroundImage();
+    require(!backdrop.isNull(), "split backdrop must have original pixels");
+    renderer.setExternalBackgroundPresented(true);
+    require(!renderer.coversWidgetRect(canvas.rect()),
+            "dynamic canvas must preserve transparent clears after splitting");
+    require(renderer.originalBackgroundRevision() == originalRevision,
+            "presentation must not change eraser and sampling source revisions");
+    require(renderCanvas(canvas, canvas.devicePixelRatioF()) == reference,
+            "QWidget::render snapshots must retain image, mask and selection");
+    require(canvas.grab().toImage().convertToFormat(QImage::Format_RGBA8888) == reference,
+            "QWidget::grab must retain the original screenshot");
+    canvas.repaint();
+    QApplication::processEvents();
+    auto* store = canvas.backingStore();
+    require(store && store->paintDevice()->devType() == QInternal::Image,
+            "split test must retain a readable raster backing store");
+    const QImage dynamic = static_cast<QImage*>(store->paintDevice())->copy();
+    require(dynamic.pixelColor(dynamic.width() / 2, dynamic.height() / 2).alpha() == 0,
+            "on-screen canvas must omit the screenshot inside the selection");
+    QImage combined = backdrop.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    combined.setDevicePixelRatio(canvas.devicePixelRatioF());
+    {
+        QPainter painter(&combined);
+        painter.drawImage(QPointF(), dynamic);
+    }
+    const QImage expected = reference.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    require(combined.size() == expected.size(), "split layers must retain physical pixel bounds");
+    int differingPixels = 0;
+    int maximumRgbDelta = 0;
+    int maximumAlphaDelta = 0;
+    for (int y = 0; y < expected.height(); ++y) {
+        for (int x = 0; x < expected.width(); ++x) {
+            const QColor a = combined.pixelColor(x, y);
+            const QColor b = expected.pixelColor(x, y);
+            differingPixels += a != b;
+            maximumRgbDelta =
+                std::max({maximumRgbDelta, std::abs(a.red() - b.red()),
+                          std::abs(a.green() - b.green()), std::abs(a.blue() - b.blue())});
+            maximumAlphaDelta = std::max(maximumAlphaDelta, std::abs(a.alpha() - b.alpha()));
+        }
+    }
+    std::cerr << "Layer comparison: differing_pixels=" << differingPixels
+              << " max_rgb_delta=" << maximumRgbDelta << " max_alpha_delta=" << maximumAlphaDelta
+              << " dpr=" << canvas.devicePixelRatioF() << '\n';
+    // The intermediate 8-bit alpha layer introduces one extra rounding step.
+    // Retain exact alpha and allow at most one RGB level per final component.
+    if (maximumRgbDelta > 1 || maximumAlphaDelta != 0) {
+        const QString diagnosticDir = qEnvironmentVariable("SNOW_SHOT_RENDER_DIFF_DIR");
+        if (!diagnosticDir.isEmpty()) {
+            QDir().mkpath(diagnosticDir);
+            expected.save(diagnosticDir + QStringLiteral("/expected.png"));
+            combined.save(diagnosticDir + QStringLiteral("/combined.png"));
+            dynamic.save(diagnosticDir + QStringLiteral("/dynamic.png"));
+            backdrop.save(diagnosticDir + QStringLiteral("/backdrop.png"));
+        }
+    }
+    require(maximumRgbDelta <= 1 && maximumAlphaDelta == 0,
+            "split composition must retain alpha and match within one 8-bit rounding level");
+    renderer.setOcrPresentation(std::make_shared<ScreenshotOcrPresentation>());
+    require(!renderer.canPresentExternalBackground(), "visible OCR must use the existing path");
+    renderer.setOcrVisible(false);
+    require(renderer.canPresentExternalBackground(), "hidden OCR must not prevent splitting");
+    renderer.setOcrVisible(true);
+    require(!renderer.canPresentExternalBackground(), "showing OCR must restore the fallback");
+    renderer.clearOcrPresentation();
+    renderer.setRenderMode(ScreenshotCanvasRenderer::RenderMode::ScrollingCapture);
+    require(!renderer.canPresentExternalBackground(), "scrolling must use the existing path");
+    renderer.setRenderMode(ScreenshotCanvasRenderer::RenderMode::PinnedResult);
+    require(!renderer.canPresentExternalBackground(), "pinned windows must use the existing path");
+    renderer.setRenderMode(ScreenshotCanvasRenderer::RenderMode::Standard);
+    source = source.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    source.setPixelColor(40, 30, Qt::transparent);
+    renderer.setImage(source, sourceRect);
+    require(!renderer.canPresentExternalBackground(), "transparent images must not be split");
+    renderer.setImage(backdrop, sourceRect);
+    require(canvas.setViewportCamera(0, 0, 0.5), "zoom out split background");
+    require(!renderer.canPresentExternalBackground(), "viewport gaps must disable splitting");
+    renderer.reset();
+    require(!renderer.externalBackgroundPresented(), "reset must retire split presentation");
