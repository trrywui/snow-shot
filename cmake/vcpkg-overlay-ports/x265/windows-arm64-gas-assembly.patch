--- /dev/null
+++ b/source/cmake/WindowsArm64Assembly.cmake
@@ -0,0 +1,37 @@
+# The caller must opt in explicitly and supply vcpkg's existing host tools.
+# GAS-preprocessor runs cl's preprocessor before translating to ARMASM64 syntax.
+function(x265_validate_msvc_arm64_assembly)
+    if(NOT (MSVC AND ARM64 AND WIN32))
+        message(FATAL_ERROR "ENABLE_MSVC_ARM64_ASSEMBLY requires MSVC Windows ARM64")
+    endif()
+    if(NOT ENABLE_ASSEMBLY)
+        message(FATAL_ERROR "ENABLE_MSVC_ARM64_ASSEMBLY requires ENABLE_ASSEMBLY=ON")
+    endif()
+    foreach(extension IN ITEMS ENABLE_NEON_DOTPROD ENABLE_NEON_I8MM ENABLE_SVE ENABLE_SVE2)
+        if(${extension})
+            message(FATAL_ERROR "The baseline ARMASM64 backend requires ${extension}=OFF")
+        endif()
+    endforeach()
+endfunction()
+
+function(x265_add_msvc_arm64_assembly out_var source)
+    foreach(tool IN ITEMS PERL_EXECUTABLE X265_GASPREPROCESSOR X265_ARMASM64_EXECUTABLE)
+        if(NOT EXISTS "${${tool}}")
+            message(FATAL_ERROR "Windows ARM64 assembly requires ${tool}")
+        endif()
+    endforeach()
+    get_filename_component(name "${source}" NAME)
+    get_filename_component(assembly_dir "${source}" DIRECTORY)
+    set(object "${CMAKE_CURRENT_BINARY_DIR}/${name}.obj")
+    # Included macro files affect the assembled object as well as the top-level source.
+    file(GLOB assembly_includes "${assembly_dir}/*.S")
+    add_custom_command(
+        OUTPUT "${object}"
+        COMMAND "${PERL_EXECUTABLE}" "${X265_GASPREPROCESSOR}"
+            -arch aarch64 -as-type armasm -- "${X265_ARMASM64_EXECUTABLE}"
+            -nologo -DPIC=1 ${ASM_FLAGS} -c "${source}" -o "${object}"
+        DEPENDS "${source}" ${assembly_includes} "${X265_GASPREPROCESSOR}"
+        VERBATIM)
+    set_source_files_properties("${object}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
+    set(${out_var} "${object}" PARENT_SCOPE)
+endfunction()
